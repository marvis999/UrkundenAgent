# Copy to .env.local and fill in. Never commit the filled-in file.

# Required. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Slug from https://openrouter.ai/api/v1/models.
# anthropic/claude-opus-5 is the default; anthropic/claude-sonnet-5 is the
# cheaper option if you would rather not spend Opus rates on a demo run.
OPENROUTER_MODEL=anthropic/claude-opus-5

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_STRUCTURED_OUTPUTS=1   # 0 for a model that cannot enforce a JSON schema
# OPENROUTER_REFERER=https://github.com/urkunden-agent
# OPENROUTER_TITLE=Urkunden-Zuarbeit

# Model answers are cached by content hash, so re-running a document costs
# nothing and produces the same candidates. Delete the directory to force
# fresh calls, or set LLM_CACHE=0.
# LLM_CACHE=1
# LLM_CACHE_DIR=.llm-cache
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=2
