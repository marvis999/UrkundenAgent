# Copy to .env. Compose reads this file, and so does `npm run dev` via Next.

POSTGRES_DB=urkunden
POSTGRES_USER=urkunden
POSTGRES_PASSWORD=urkunden
POSTGRES_PORT=5432
APP_PORT=3000

# Used by the app. Points at the container port published on localhost, so it works
# whether the app runs locally with `npm run dev` or inside compose.
DATABASE_URL=postgres://urkunden:urkunden@localhost:5432/urkunden

# Wo die Originalunterlagen liegen. Bewusst ohne eingebauten Standardwert: einen Pfad,
# den der Build ausrechnen kann, kopiert der Build auch. Compose setzt ihn auf das Volume.
URKUNDEN_DATA_DIR=./data

# --- Model layer ---------------------------------------------------------

# Required for extraction. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Slug from https://openrouter.ai/api/v1/models.
# Must be vision-capable: scans and photos are read as page images, and a
# text-only model is rejected at routing with "no endpoints found that support
# image input". anthropic/claude-sonnet-5 is the cheaper alternative.
OPENROUTER_MODEL=anthropic/claude-opus-5

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_STRUCTURED_OUTPUTS=1   # 0 for a model that cannot enforce a JSON schema

# Model answers are cached by content hash, so re-running a document costs
# nothing and produces the same candidates. Delete the directory to force
# fresh calls, or set LLM_CACHE=0.
# LLM_CACHE=1
# LLM_CACHE_DIR=.llm-cache
# LLM_TIMEOUT_MS=180000
# LLM_MAX_RETRIES=2
